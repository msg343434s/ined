RewriteEngine On

# Enable rewrite base
RewriteBase /

# Allow direct access with query params like ?email=
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ index.php [L]

# If file or folder exists, serve it normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# OPTIONAL: fallback everything else to index.php (safe)
RewriteRule ^ index.php [L]
